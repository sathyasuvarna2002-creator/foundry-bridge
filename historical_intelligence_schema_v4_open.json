{
  "type": "object",
  "properties": {
    "historical_security_assessment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "description": "REQUIRED. Copy verbatim from the corresponding input risk's finding_id -- do not re-derive, guess, reassign, or renumber. Generated upstream in the format {CATEGORY-SLUG}-{NN} (e.g. UPGRADEABILITY-01); not a fixed enum, and not a stable cross-protocol key. Do not validate its format -- just propagate it.",
            "pattern": "^(CENTRALISATION|UPGRADEABILITY|DEPENDENCY|ECONOMIC-DEPENDENCY|ACCESS-CONTROL|GOVERNANCE|TRUST-BOUNDARY|COMPOSABILITY|ASSET-CUSTODY|OPERATIONAL-RESILIENCE)-[0-9]{2}$"
          },
          "architectural_risk": {
            "type": "string"
          },
          "precedent_found": {
            "type": "boolean"
          },
          "exploit_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "architectural_similarity": {
            "type": "string"
          },
          "architectural_differences": {
            "type": "string"
          },
          "historical_evidence": {
            "type": "string"
          },
          "evidence_strength": {
            "type": "string",
            "enum": [
              "Strong Evidence",
              "Moderate Evidence",
              "Limited Evidence",
              "No Evidence"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "finding_id",
          "architectural_risk",
          "precedent_found",
          "exploit_name",
          "protocol",
          "year",
          "category",
          "architectural_similarity",
          "architectural_differences",
          "historical_evidence",
          "evidence_strength",
          "reasoning",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "historical_security_assessment"
  ]
}
