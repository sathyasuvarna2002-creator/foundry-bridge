# Copy this file to .env and fill in the values for YOUR machine.
# server.js falls back to the original hardcoded paths if these are
# left unset, so this is only required if you're running FoundryBridge
# somewhere other than the machine it was originally built on.

# Port FoundryBridge listens on.
PORT=3000

# Absolute path to the FoundryValidation Foundry project (the one
# containing foundry.toml, src/, test/, script/).
FOUNDRY_PATH=/path/to/FoundryValidation

# Absolute paths to the Foundry binaries (run `foundryup` first, then
# `where forge` on Windows or `which forge` on Mac/Linux to find these).
# On Windows these end in .exe; on Mac/Linux they don't.
FORGE_EXE=/path/to/forge
CAST_EXE=/path/to/cast

# Only needed if you're also using the /slither endpoint.
SLITHER_PATH=/path/to/slither
PYTHON_SCRIPTS=/path/to/python/Scripts
SLITHER_OUTPUT=/path/to/slither-output.json
